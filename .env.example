# ---------------------------------------------------------------------------
# AsterNova Hospital Intelligence Platform - environment template
#
# Copy this file to `.env` in the repository root (or into `backend/.env`) and
# adjust the values.  NEVER commit real secrets: this file is a template only.
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
# Generate a fresh key for anything other than local demo use:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-demo-only-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# DB_ENGINE=sqlite (default, zero setup) or postgres
DB_ENGINE=sqlite
SQLITE_PATH=backend/db.sqlite3

# Used when DB_ENGINE=postgres (docker-compose sets these automatically)
POSTGRES_DB=asternova
POSTGRES_USER=asternova
POSTGRES_PASSWORD=asternova
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Demo data -------------------------------------------------------------
# Password for every seeded demo account. These accounts are for local
# demonstration only - never enable DEMO_MODE on a public deployment.
DEMO_MODE=True
DEMO_PASSWORD=AsterNova@2024

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg
# MEDIA_ROOT=/absolute/path/to/media

# --- OCR -------------------------------------------------------------------
ENABLE_OCR=True
# Full path to the Tesseract binary when it is not on PATH, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_MAX_PDF_PAGES=5
OCR_DPI=200

# --- AI --------------------------------------------------------------------
# AI_PROVIDER=demo keeps everything local (no API key required).
# Set AI_PROVIDER=openai and provide OPENAI_API_KEY to use a hosted model.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT=30

# --- RAG / embeddings ------------------------------------------------------
EMBEDDING_DIMENSIONS=256
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5

# --- Frontend (Vite) -------------------------------------------------------
# Leave empty to use the dev-server proxy to http://127.0.0.1:8000
VITE_API_BASE=
